{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2019",
    "outDir": "./dist",
    "rootDir": "./src",

    "strict": false,
    "noImplicitAny": false,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
